modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm run build"]
run = ["sh", "-c", "RUN_MIGRATIONS_ON_BOOT=true node artifacts/api-server/dist/index.mjs"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

# Development only — the "Project" run button previously pointed at no
# defined workflow at all, so nothing started automatically and the API
# server had to be launched by hand every session. This runs the web app
# (Vite dev server, hot reload) and the API server side by side; the web
# app's own dev proxy (see artifacts/tastekin/vite.config.ts) forwards
# /api/* to the API server so the browser only ever talks to one origin —
# the deployed app (see [deployment] above) is unaffected, since it always
# builds once and serves everything from api-server on a single port.
[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/tastekin: web"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "dbus", "atk", "at-spi2-atk", "cups", "libdrm", "at-spi2-core", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libxkbcommon", "mesa", "pango", "cairo", "alsa-lib", "libgbm"]

[userenv]

[userenv.development]
FHEED_OWNER_ID = ""
BUNNY_STREAM_CDN_HOSTNAME = "vz-99755baf-b81.b-cdn.net"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 23385
externalPort = 80
